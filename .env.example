# .env.example（T15）—— docker compose 环境变量样例
#
# 用法：  cp .env.example .env
#        把下方【必填】项全部填好（少一项 `docker compose up` 直接失败）
#        再 docker compose up -d
#
# 标记约定：  【必填】= compose 用 ${VAR:?…} 强制，缺失/为空即报错
#            【可选】= 有默认值，一般不用动，冲突或特殊部署时才改

# ═══════════════════════════════════════════════════════════════════════
# 必填清单（共 5 项，一眼看完就知道要填什么）
# ═══════════════════════════════════════════════════════════════════════
#   ① GT_AUTH_TOKENS          鉴权 token 表        alice=gt_tok_xxx:admin,bob=gt_tok_yyy
#   ② GT_PUBLIC_HOST          对外通告主地址       192.168.31.87 或 gametrace.example.com
#   ③ GT_PUBLIC_REGISTRY_PORT 对外 registry 端口   19091
#   ④ GT_PUBLIC_INGEST_PORT   对外 ingest 端口     19092
#   ⑤ GT_LAN_IP               手机扫码 LAN 地址    192.168.31.87
#   含义与填法见下方【必填】各段。

# ═══════════════════════════════════════════════════════════════════════
# 【必填】① 鉴权 token 表（gt-pipeline 与 gt-mcp 共用）
# ═══════════════════════════════════════════════════════════════════════
GT_AUTH_TOKENS=alice=gt_tok_change_me:admin,bob=gt_tok_change_me2
# 含义：访问服务的凭证表，格式 owner=token，多个用逗号分隔。
# 规则：
#   - 必须带 owner（如 alice=）；裸 token 会被 ParseTokens 拒绝、服务起不来；
#   - token 后加 :admin 授予该 owner 管理员权限；
#   - 生成：openssl rand -hex 24，前缀用 gt_tok_（如 gt_tok_xxxxxxxx）。

# ═══════════════════════════════════════════════════════════════════════
# 【必填】②~⑤ 对外通告地址（Docker / NAT / 公网部署必填）
# ═══════════════════════════════════════════════════════════════════════
# 为什么必填：容器内服务端监听地址（如 :9091）与远端探针/手机真正能连到的地址
# （宿主机IP:19091）不是同一个；容器内还可能是 172.x 这类不可达网段。不显式
# 通告，服务会以不可达地址静默上线，探针/手机连不上。四个变量均在 compose 里
# 用 ${VAR:?…} 强制，缺失/为空 → docker compose up 直接失败。
# 本机直连（同机同网段）可把②③④⑤都填同一个宿主机局域网 IP。

GT_PUBLIC_HOST=192.168.31.87
# ② 对外通告主地址：公网域名或宿主机在远端可达的 IPv4。
#    探针回连、MCP 接入、AI 回连都用它。

GT_PUBLIC_REGISTRY_PORT=19091
# ③ 对外通告 registry 宿主端口 = 下方【端口映射】的 GT_REGISTRY_PORT（默认 19091）。

GT_PUBLIC_INGEST_PORT=19092
# ④ 对外通告 ingest 宿主端口 = 下方【端口映射】的 GT_AGENT_INGEST_PORT（默认 19092）。

GT_LAN_IP=192.168.31.87
# ⑤ 手机扫码连代理用：宿主机在手机所在 LAN 内的可达 IPv4。
#    与 GT_PUBLIC_HOST 同网段时直接填同值（如都 192.168.31.87）。
#    容器内启发式只拿到 172.x，必须显式填，否则手机扫码连不上。

# ═══════════════════════════════════════════════════════════════════════
# 【可选】PostgreSQL 存储（均有默认值，本机开发可不动）
# ═══════════════════════════════════════════════════════════════════════
GT_PG_USER=gametrace
GT_PG_PASSWORD=gt_dev_pass
GT_PG_DB=gametrace
# 含义：初始化 postgres 容器 + 拼接 GT_DB_DSN 用，三者保持一致即可。
# 默认密码仅限本机开发，正式部署务必改 GT_PG_PASSWORD。

# ═══════════════════════════════════════════════════════════════════════
# 【可选】端口映射（宿主侧；均有默认值，与已占用端口冲突时才改）
# ═══════════════════════════════════════════════════════════════════════
GT_CONTROL_PORT=19888
# CaptureControl gRPC（mcp/管理端连 pipeline）。宿主侧用 1xxxx 偏移，避免与本机
# GameTrace 链路 9888 冲突。
GT_REGISTRY_PORT=19091
# PluginRegistry gRPC（插件注册）。注意：这是宿主侧端口，不是容器内 9091。
# 宿主上手动跑插件必须显式指过来：GT_REGISTRY_ADDR=127.0.0.1:19091 ./plugin.exe
GT_AGENT_INGEST_PORT=19092
# AgentIngest gRPC（gt-agent 推流入口）。
GT_MCP_PORT=18781
# MCP HTTP/SSE + Web UI（浏览器访问 http://<host>:18781）。
GT_PROXY_PORTS=12100-12199
# 代理抓包手机 CONNECT 端口段（gt-singbox-agent 绑 0.0.0.0 全接口）。

# ═══════════════════════════════════════════════════════════════════════
# 【可选】容器内监听地址（默认 :port 即可，一般不用改）
# ═══════════════════════════════════════════════════════════════════════
# 仅 pipeline 服务的监听地址可改；mcp 连 pipeline 已由 compose 固定为 pipeline:9888。
GT_CONTROL_ADDR=:9888
GT_REGISTRY_ADDR=:9091
GT_AGENT_INGEST_ADDR=:9092
GT_MCP_ADDR=:8781
GT_INTERNAL_REGISTRY_ADDR=pipeline:9091
# mcp 容器内拉起插件时注入的 registry 地址（compose 网络内），默认 pipeline:9091。
# 与【必填】③ 的 GT_PUBLIC_REGISTRY_PORT（宿主发布端口 19091）语义相反，勿混。

# ═══════════════════════════════════════════════════════════════════════
# 【可选】CORS / 版本 / 前端调试
# ═══════════════════════════════════════════════════════════════════════
GT_MCP_ALLOWED_ORIGINS=
# MCP CORS 允许的 Origin（逗号分隔，如 http://localhost:5173）；留空不返回 CORS 头。
GT_VERSION=dev
# 镜像 tag（与 Makefile -X ldflags 同源）；改了要重新 build。
GT_GIT_COMMIT=unknown
# 构建注入的 commit（展示用）。
VITE_ENABLE_RAW_DEBUG=0
# 前端「原始包」调试页开关（构建期注入，0=关 1=开；仅开发/插件调试场景开 1）。

# ═══════════════════════════════════════════════════════════════════════
# 【可选】镜像构建策略
# ═══════════════════════════════════════════════════════════════════════
GT_BUILD_NO_CACHE=true
# 每次 up 是否禁用 BuildKit 层缓存（默认 true=完全重建）。本机迭代嫌慢：
#   GT_BUILD_NO_CACHE=false docker compose up -d
GT_BUILD_PULL=true
# 每次 up 是否检查基础镜像更新（默认 true）。离线环境：
#   GT_BUILD_PULL=false docker compose up -d

# ═══════════════════════════════════════════════════════════════════════
# 【可选】gt-agent 客户端连接（供团队成员参考，非 compose 使用）
# ═══════════════════════════════════════════════════════════════════════
# 团队成员本机运行（registry 用映射后宿主端口 19091，ingest 自动取 19092）：
#   gt-agent --token gt_tok_xxx --server <服务器IP>:19091
# 更省事：前端「接入设备」生成启动码，目标机执行一条命令自动领配置回连，无需手填。
